# Local secrets and machine-specific configuration
.env
.env.*
!.env.example
config.yaml
config/*.local.yaml
preferences.yaml
secrets/
storage_state*.json

# Runtime state and generated data
runtime/
data/*
!data/.gitkeep
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.db
*.db-shm
*.db-wal
*.log

# Browser and Playwright artifacts
playwright-report/
test-results/
blob-report/
traces/

# Editors and operating systems
.idea/
